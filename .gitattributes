# Shell scripts and CI definitions must keep LF endings: they run inside the
# TrimUI Smart Pro (Linux) and inside the Linux build container.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
# Go sources are stored as LF and `gofmt -l` reports CRLF as unformatted, so a
# Windows checkout must not convert them: without this every contributor with
# core.autocrlf=true sees the whole tree as unformatted.
*.go text eol=lf