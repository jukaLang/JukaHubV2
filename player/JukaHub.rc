/* JukaHub Windows resource script.
 *
 * This is what gives JukaHub.exe its own icon in Explorer, the taskbar,
 * Alt-Tab, the title bar and the Start menu; without it Windows shows the
 * generic application icon for every build.
 *
 * The compiled form (rsrc_windows_amd64.syso) is what the Go linker picks up,
 * so a plain "go build" on windows/amd64 gets the icon with no extra flags.
 * branding/mklogo.py writes both JukaHub.ico and the .syso; build.bat (and
 * mkwinres.sh) recompile the .syso from this script with windres.
 */
1 ICON "JukaHub.ico"

/* Per-monitor-v2 DPI awareness (DESK-2). Windows reads the manifest before
 * SDL starts, so the logical canvas and the window scale agree from the first
 * frame; the legacy dpiAware line is the fallback for Windows 8.1. */
1 24 "JukaHub.manifest"
