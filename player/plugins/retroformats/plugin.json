{
  "name": "retroformats",
  "title": "Retro formats",
  "version": "1.2.0",
  "description": "Teaches the game library five formats it does not know out of the box: Pokémon mini, Watara Supervision, Vectrex, Atari Lynx and Arduboy. (WASM-4 is built in now: Roms/WASM4.)",
  "author": "JukaHub",
  "entry": "retroformats.sh",
  "icon": "rom",
  "enabled": true,
  "actions": [
    {"id": "list", "label": "Formats it adds"},
    {"id": "@open-library", "label": "Open the library"}
  ],
  "romParsers": [
    {"name": "Pokémon mini", "system": "pokemini", "extensions": [".min"]},
    {"name": "Watara Supervision", "system": "supervision", "extensions": [".sv"]},
    {"name": "Vectrex", "system": "vectrex", "extensions": [".vec", ".gam"], "magic": "672047434520"},
    {"name": "Atari Lynx", "system": "lynx", "extensions": [".lnx"], "magic": "4C594E58"},
    {"name": "Arduboy", "system": "arduboy", "extensions": [".arduboy"], "magic": "504B0304"}
  ],
  "onEnable": "list",
  "quick": ["list"]
}
