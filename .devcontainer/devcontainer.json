{
  // The image and feature versions are pinned so every container is identical.
  // mise.toml records the same pins for people who use mise/asdf instead of
  // containers; go.mod's toolchain directive is the code-level source of truth.
  "name": "JukaHub",
  "image": "mcr.microsoft.com/devcontainers/go:1.26-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libsdl2-dev libsdl2-image-dev libsdl2-ttf-dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "EditorConfig.EditorConfig",
        "vscodevim.vim"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
